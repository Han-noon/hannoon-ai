# LLM (OpenAI 호환 API, 기본 대상 OpenRouter)
LLM_API_KEY=your_openrouter_api_key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=120
# OpenRouter 제공자 고정(쉼표 구분)과 폴백 허용 여부
LLM_PROVIDER_ONLY=streamlake
LLM_PROVIDER_ALLOW_FALLBACKS=false
# 분당 호출 상한(0이면 무제한)과 429·일시 오류 제자리 재시도 횟수
LLM_MAX_RPM=10
LLM_TRANSIENT_RETRIES=6
# 설정 시에만 LLM 응답 디스크 캐시를 켠다
# LLM_CACHE_DIR=.llm_cache

# 임베딩 (로컬 sentence-transformers, API 키 불필요)
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
EMBEDDING_DIMENSIONS=768

DATABASE_URL=your_postgres_database_url

LLM_DEFAULT_MODEL=solar-mini
LLM_CLEANUP_MODEL=solar-mini
LLM_ARTICLE_MODEL=solar-mini
LLM_ABUSE_MODEL=solar-mini
LLM_SUMMARY_MODEL=solar-mini
LLM_ABUSE_ENABLED=false
LLM_TOPIC_EVENT_MODEL=solar-pro3
LLM_TOPIC_MODEL=solar-pro3
# 이벤트 분류: major/minor/entities 추출·이벤트명 생성
LLM_EVENT_MODEL=qwen/qwen3-30b-a3b-instruct-2507

# 이벤트 분류: 배정 판단(Jev, TypeSafe)
TYPESAFE_API_KEY=your_typesafe_api_key
JEV_MODEL=jev-1.13.0
EVENT_JEV_ASSIGN_THRESHOLD=0.30

# 이벤트 분류: 후보 검색
EVENT_BATCH_SIZE=5
EVENT_CANDIDATE_LIMIT=12
EVENT_VECTOR_FETCH_LIMIT=100
EVENT_ENTITY_CANDIDATE_LIMIT=50
EVENT_ENTITY_DF_CUTOFF_EVENTS=20
EVENT_ENTITY_DF_CUTOFF_DAYS=90
EVENT_ENTITY_DISTANCE_CEILING=0.7
EVENT_MIN_SHARED_ENTITIES=2
# 후보 검색·판정 진단 로그(JSONL). 설정 시에만 기록
# CANDIDATE_LOG_PATH=logs/candidates.jsonl

TOPIC_BATCH_SIZE=10
TOPIC_CANDIDATE_LIMIT=12
TOPIC_MIN_NET_ARTICLE_COUNT=5
TOPIC_DISTANCE_THRESHOLD=0.50
TOPIC_ASSIGN_SCORE_THRESHOLD=0.75
