        "properties": {
          "child_subtopic_id": {
            "type": "string"
          },
          "container_subtopic_id": {
            "type": "string"
          },
          "same_process_instance": {
            "type": "boolean"
          },
          "child_scope_subset": {
            "type": "boolean"
          }
